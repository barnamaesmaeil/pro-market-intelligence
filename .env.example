# Pro Market Intelligence — environment variables
# Copy this file to .env and fill in real values. Never commit .env to Git.

# --- Required ---

# MySQL connection string used by Drizzle ORM (drizzle.config.ts, server/db.ts)
DATABASE_URL="mysql://user:password@localhost:3306/promarket"

# Twelve Data API key — used server-side only for XAU/USD and forex data.
# Get a key at https://twelvedata.com and keep it out of source code, the
# browser, CSV exports and APK builds.
TWELVE_DATA_API_KEY=""

# --- Optional (platform / auth layer) ---

# Auth/JWT cookie secret for the server session layer
MANUS_JWT_SECRET=""

# Project/app identifier used by the auth layer
MANUS_PROJECT_ID=""

# OAuth server URL, if an external OAuth provider is configured
MANUS_OAUTH_API_URL=""

# OpenID of the owner account (optional role hint)
OWNER_OPEN_ID=""

# Runtime
NODE_ENV="development"
